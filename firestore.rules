rules_version = '2';

// Security rules for the hosted site's Firebase database.
// Paste these into Firebase: Firestore Database, Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's own saved copy: only they can read or change it.
    match /data/users/{uid}/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared kitchens. Only members can see or change one.
    match /households/{code} {
      // Whoever creates it is its first member.
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow update: if request.auth != null && (
        // Members change the kitchen but not who's in it...
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        // ...and someone with the code can add themselves, and nothing else.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
      );

      allow delete: if false;
    }
  }
}
